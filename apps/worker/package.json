    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@pospay/config": "workspace:*",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
