<?xml version="1.0" encoding="utf-8"?>
<!-- تخزين التطبيق ما يسافرش مع نسخة السحابة ولا مع نقل الجهاز: موبايل متنسوخ ما يجيبش
     معاه اعتماد كاونتر شغّال (spec 065 FR-013). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
