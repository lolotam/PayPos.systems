{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "deny",
    "external_directory": "deny",
    "read": {
      "*": "allow",
      ".git": "deny",
      ".git/*": "deny",
      "*/.git": "deny",
      "*/.git/*": "deny",
      "*\\.git": "deny",
      "*\\.git\\*": "deny"
    },
    "edit": {
      "*": "allow",
      ".git": "deny",
      ".git/*": "deny",
      "*/.git": "deny",
      "*/.git/*": "deny",
      "*\\.git": "deny",
      "*\\.git\\*": "deny"
    },
    "glob": {
      "*": "allow",
      ".git": "deny",
      ".git/*": "deny",
      "*/.git": "deny",
      "*/.git/*": "deny",
      "*\\.git": "deny",
      "*\\.git\\*": "deny"
    },
    "list": {
      "*": "allow",
      ".git": "deny",
      ".git/*": "deny",
      "*/.git": "deny",
      "*/.git/*": "deny",
      "*\\.git": "deny",
      "*\\.git\\*": "deny"
    },
    "bash": {
      "*": "allow",
      "git": "deny",
      "git *": "deny",
      "*git *": "deny",
      "*git.exe*": "deny",
      "*/git": "deny",
      "*.git*": "deny",
      "*gitdir*": "deny",
      "bash -c*": "deny",
      "sh -c*": "deny",
      "powershell*": "deny",
      "pwsh*": "deny",
      "cmd /c*": "deny",
      "cmd.exe*": "deny"
    },
    "todowrite": "allow",
    "todoread": "allow",
    "grep": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "task": "deny"
  }
}
