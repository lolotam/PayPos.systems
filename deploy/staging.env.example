# The server-side .env of deploy/docker-compose.staging-shared.yml, in /opt/pospay-staging/.env (mode 600).
# Keys only — no real values here, and never commit the filled file (CLAUDE.md §8). Generated on the server;
# deploy/staging-deploy.sh rewrites IMAGE_TAG on every deploy. Every ${VAR:?} in the compose file is one of these.

# Image to run — a commit SHA from main, never `latest`
IMAGE_TAG=
# Optional; defaults to ghcr.io/lolotam
REGISTRY=
# Public host Traefik routes to the API, e.g. staging.pospay.systems
STAGING_HOST=
LOG_LEVEL=info

# The server's shared Postgres and Redis on dokploy-network
DB_HOST=
DB_NAME=
REDIS_HOST=
REDIS_PASSWORD=

# The migrate step's owner connection (URL-encoded password)
MIGRATION_DATABASE_URL=
# Role passwords, created by the migrate step (ADR-0003 §3), 16+ characters each
POSTGRES_APP_PASSWORD=
POSTGRES_AUTH_PASSWORD=
POSTGRES_DISPATCHER_PASSWORD=

# Better Auth — 32+ characters
BETTER_AUTH_SECRET=

# ADR-0013 Part A: optional inbound activation, independent from outbound/OTP (still PR 6 gated).
# Create/set the restricted role password through migrate; inject its URL into API + worker.
POSTGRES_NOTIFICATIONS_PASSWORD=
PLATFORM_NOTIFICATIONS_DATABASE_URL=
# API only, no sending access token: Meta subscription verification + the two frozen HMAC keys.
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
NOTIFICATION_PHONE_HASH_KEY=
NOTIFICATION_PHONE_HASH_KEY_ID=
NOTIFICATION_MESSAGE_ID_HASH_KEY=
# TODO(spec): exact approved STOP button id. Empty accepts the five approved text commands only.
WHATSAPP_STOP_BUTTON_ID=
# Exact Traefik proxy CIDRs. Empty trusts no forwarded client IP.
TRUSTED_PROXY_CIDRS=
# Future outbound provider credentials, worker only; providing these does not lift the PR 6 gate.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v23.0
