# syntax=docker/dockerfile:1
# apps/worker — multi-stage on node:24-bookworm-slim (ADR-0048). The API image stays on Alpine.
# Chromium headless shell is installed here for packages/documents (playwright-core 1.63.0).
# Nothing is downloaded at runtime. The final process is USER node, never root.

FROM node:24-bookworm-slim AS build
RUN npm install -g pnpm@12.5.1
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm turbo run build --filter=@pospay/worker...
RUN pnpm --filter @pospay/worker deploy --prod --legacy /out/worker

FROM node:24-bookworm-slim AS worker
ENV NODE_ENV=production \
    WORKER_HOST=0.0.0.0 \
    WORKER_PORT=3001 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
WORKDIR /app
COPY --from=build --chown=node:node /out/worker .
RUN node node_modules/@pospay/documents/scripts/install-headless-shell.mjs --with-deps \
    && rm -rf /var/lib/apt/lists/* \
    && chown -R node:node /ms-playwright
USER node
# ADR-0022 / ADR-0048: sharp smoke on the glibc image, then the PDF smoke which refuses uid 0.
RUN node node_modules/@pospay/storage/scripts/native-smoke.mjs
RUN node node_modules/@pospay/documents/scripts/pdf-smoke.mjs
EXPOSE 3001
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:'+process.env.WORKER_PORT+'/health').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["node", "dist/main.js"]
