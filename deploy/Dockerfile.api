# syntax=docker/dockerfile:1
# apps/api (and its migration step) — multi-stage on node:24-alpine (ADR-0002), production dependencies only.
# Built in CI and tagged by commit SHA, never `latest` (CLAUDE.md §10). No secret is baked in: every value comes from
# the environment Dokploy injects at run time.

FROM node:24-alpine AS build
RUN npm install -g pnpm@12.5.1
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm turbo run build --filter=@pospay/api...
RUN pnpm --filter @pospay/api deploy --prod --legacy /out/api \
 && pnpm --filter @pospay/db deploy --prod --legacy /out/migrate \
 && pnpm --filter @pospay/auth deploy --prod --legacy /out/ops

# Migrations run as their own step before new containers start (plan T13): one-shot, exits when done.
FROM node:24-alpine AS migrate
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /out/migrate .
USER node
CMD ["node", "scripts/migrate.ts"]

# Operator one-shots (G4, PR-E): `docker run --rm` containers for the TypeScript operator scripts, which Node 24 cannot
# run from inside node_modules. /app holds @pospay/auth (scripts/create-user.ts, on AUTH_DATABASE_URL); /app/db holds
# @pospay/db (scripts/platform-grant.ts, seed.ts, platform-commission-approval.ts, on MIGRATION_DATABASE_URL). Each tree
# keeps its own node_modules, so the two packages' src/ never collide. No env value is baked in.
FROM node:24-alpine AS ops
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /out/ops .
COPY --from=build --chown=node:node /out/migrate ./db
USER node
# Non-destructive smoke: every script must load its TypeScript and fail with its own usage / missing-env message,
# never a module or syntax error. No database is reached.
RUN node scripts/create-user.ts 2>&1 | grep -q 'usage: --email' \
 && node db/scripts/platform-grant.ts 2>&1 | grep -q 'MIGRATION_DATABASE_URL is not set' \
 && node db/scripts/platform-commission-approval.ts 2>&1 | grep -q 'usage: --expires' \
 && node db/scripts/seed.ts 2>&1 | grep -q 'MIGRATION_DATABASE_URL is not set'
CMD ["node", "scripts/create-user.ts"]

FROM node:24-alpine AS api
ENV NODE_ENV=production API_HOST=0.0.0.0 API_PORT=3000
WORKDIR /app
COPY --from=build --chown=node:node /out/api .
USER node
# ADR-0022: نفس فحص sharp يعمل في CI على صورة الإنتاج وmusl، دون تشغيل خدمة.
RUN node node_modules/@pospay/storage/scripts/native-smoke.mjs
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=3 \
  CMD wget -qO- "http://127.0.0.1:${API_PORT}/health" >/dev/null || exit 1
CMD ["node", "dist/main.js"]
