# syntax=docker/dockerfile:1
# apps/pos — static PWA on nginxinc/nginx-unprivileged (ADR-0017).
# VITE_API_URL is inlined at build time. An empty build arg fails closed in the browser.
# No secret is copied in. The image is not wired into compose or a deploy script.

FROM node:24-alpine AS build
RUN npm install -g pnpm@12.5.1
WORKDIR /repo
COPY . .
ARG VITE_API_URL=
ENV VITE_API_URL=$VITE_API_URL
RUN pnpm install --frozen-lockfile
RUN pnpm turbo run build --filter=@pospay/pos...

FROM nginxinc/nginx-unprivileged:1.30.5-alpine
COPY deploy/pos-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build --chown=nginx:nginx /repo/apps/pos/dist /usr/share/nginx/html
USER nginx
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1
