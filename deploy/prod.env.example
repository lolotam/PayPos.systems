# The Dokploy environment of the compose service pospay-prod (its own Dokploy project) that runs
# deploy/docker-compose.prod.yml. Keys only — no real values here, and never commit the filled file (CLAUDE.md §8).
# Edited in the Dokploy UI only (it is encrypted at rest). Every ${VAR:?} in the compose file is one of these,
# except IMAGE_TAG: the release step pins the image SHA in the uploaded compose file (pipeline skill §6), so
# IMAGE_TAG is not set here. Every secret is freshly generated for production — none copied from staging.

# Required — every ${VAR:?} in the compose file is one of these

# Public hosts behind Traefik (ADR-0001 §1, §6): api., app. and pos.pospay.systems
API_HOST=
ADMIN_HOST=
POS_HOST=
# The database the Postgres container creates on first start (POSTGRES_DB in the compose)
DB_NAME=
# Every password below is interpolated raw into postgres:// and redis:// URLs by the compose — compose cannot
# percent-encode. Generate each one from the URL-safe alphabet (A-Z a-z 0-9 - _) so no encoding is ever needed:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# (24 bytes = 32 characters; still 16+ characters as ADR-0003 §3 requires.)
# The Postgres initdb superuser password; the migrate and seed URLs are built from it inside the compose
POSTGRES_OWNER_PASSWORD=
# Role passwords, created by the migrate step (ADR-0003 §3), freshly generated, never copied from staging
POSTGRES_APP_PASSWORD=
POSTGRES_AUTH_PASSWORD=
POSTGRES_DISPATCHER_PASSWORD=
# The production Redis container's password — never the staging one
REDIS_PASSWORD=
# Better Auth — 32+ characters
BETTER_AUTH_SECRET=
# Exact Traefik proxy CIDRs on this server. compose refuses to run without it: empty CIDRs disable WhatsApp intake
# and rating links and leave every visitor on the proxy's address (plan gap B4)
TRUSTED_PROXY_CIDRS=

# pgBackRest — the WAL archive to R2 (ADR-0062 §2-3): one R2 bucket used for nothing else, one API token scoped to
# that bucket (Object Read & Write), and the cipher pass generated once. The compose fixes type=s3, path-style URIs,
# zst compression, async spooling, encryption aes-256-cbc and retention of two full backups; these six keys are the
# per-deployment values.
PGBACKREST_REPO1_S3_ENDPOINT=
PGBACKREST_REPO1_S3_BUCKET=
PGBACKREST_REPO1_S3_REGION=auto
PGBACKREST_REPO1_S3_KEY=
PGBACKREST_REPO1_S3_KEY_SECRET=
# Path of the repository inside the bucket (one dedicated bucket: any path, e.g. /repo)
PGBACKREST_REPO1_PATH=
# Encrypts every backup; kept by Waleed off the server — without it every backup is unreadable (ADR-0062 §4)
PGBACKREST_REPO1_CIPHER_PASS=

# Optional

# Optional; defaults to ghcr.io/lolotam
REGISTRY=
LOG_LEVEL=info
# DATABASE_POOL_MAX sizes each api process's regular pospay_app pool only (default 10). When staff OTP is READY the
# same process also opens the bounded OTP pool of 8. The notifications and auth pools count too, so Postgres
# max_connections must cover all of them plus the worker and dispatcher.
DATABASE_POOL_MAX=10
# The session cookie is shared across the production subdomains (ADR-0001 §6); the compose defaults to .pospay.systems
COOKIE_DOMAIN=
# Defaults to https://<ADMIN_HOST>,https://<POS_HOST>; only set to add origins
AUTH_TRUSTED_ORIGINS=

# By capability: staff OTP (ADR-0019)

# Absent/empty STAFF_OTP_ENABLED is disabled. Partial settings close OTP only.
# Both roots need identical independent base64 keys (32+ decoded bytes); never reuse either family.
# Retired-key values are optional JSON objects mapping retained key ids to base64 keys.
# Explicit POS Origin must appear in AUTH_TRUSTED_ORIGINS (API and worker); the compose derives
# STAFF_OTP_POS_ORIGIN from POS_HOST when unset (plan gap B9).
# Only the worker receives WHATSAPP_ACCESS_TOKEN. Live activation also needs verified STOP subscription.
STAFF_OTP_ENABLED=
STAFF_OTP_POS_ORIGIN=
STAFF_OTP_DERIVATION_KEY=
STAFF_OTP_DERIVATION_KEY_ID=
STAFF_OTP_DERIVATION_RETIRED_KEYS=
STAFF_OTP_VERIFICATION_KEY=
STAFF_OTP_VERIFICATION_KEY_ID=
STAFF_OTP_VERIFICATION_RETIRED_KEYS=
STAFF_OTP_TEMPLATES_APPROVED=
STAFF_OTP_TEMPLATE_AR=
STAFF_OTP_TEMPLATE_EN=
STAFF_OTP_COMPONENTS_AR=
STAFF_OTP_COMPONENTS_EN=
WHATSAPP_STOP_SUBSCRIPTION_CONFIRMED=
NOTIFICATIONS_MODE=

# By capability: WhatsApp intake (ADR-0013)
#
# Per-service distribution as wired in the compose: the API receives the Meta subscription secrets, the phone-hash
# keys and the STOP button (intake verification, no sending token); the worker receives the same app secret,
# verify token, WABA and phone-number ids and the message-id hash key through the shared anchor, plus the
# outbound WHATSAPP_ACCESS_TOKEN and WHATSAPP_PHONE_NUMBER_ID below. Both containers see the shared intake keys;
# only the worker can send.

# API intake verification + the two frozen HMAC keys (worker receives app secret, verify token, WABA,
# phone-number id and the message-id hash key through the shared anchor)
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
NOTIFICATION_PHONE_HASH_KEY=
NOTIFICATION_PHONE_HASH_KEY_ID=
NOTIFICATION_MESSAGE_ID_HASH_KEY=
WHATSAPP_STOP_BUTTON_ID=
# The restricted pospay_notifications role password (created through migrate); the compose builds its connection
# URL internally from postgres:5432 and DB_NAME. Empty = the notifications capability stays off.
POSTGRES_NOTIFICATIONS_PASSWORD=
# Worker-only outbound credentials; providing them does not lift the sending gate
WHATSAPP_ACCESS_TOKEN=

# By capability: rating links (ADR-0057)

# Worker only; empty = capability DISABLED
RATING_TOKEN_DERIVATION_KEY=
RATING_TOKEN_DERIVATION_KEY_VERSION=
RATING_TOKEN_DERIVATION_RETIRED_KEYS=
# The public origin customers' rating links open on (API only); https in production, and the API refuses the API
# origin or any AUTH_TRUSTED_ORIGINS entry. Empty = rating links stay off.
RATING_PAGE_ORIGIN=

# By capability: staff web push (ADR-0052)

# Generated once with `pnpm push:generate-vapid`. The API receives the public key and the subject;
# only the worker receives the private key (VAPID_PRIVATE_KEY never reaches the api container).
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=
VAPID_PRIVATE_KEY=

# By capability: private files on R2 (packages/storage)

# Own production bucket and token, never the staging ones. Any of endpoint, bucket or the two keys missing = uploads off.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
