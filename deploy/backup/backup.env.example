# The server-side backup.env of the logical backup (deploy/backup/README.md), in /opt/pospay-staging/backup.env
# (mode 600). Keys only — no real values here, and never commit the filled file (CLAUDE.md §8).

# The database to dump, as the migration owner (FORCE RLS hides rows from anyone else)
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=

# restic repository in Cloudflare R2: s3:https://<account-id>.r2.cloudflarestorage.com/<bucket>
RESTIC_REPOSITORY=
# Encrypts every snapshot; losing it loses every backup — keep a copy off the server
RESTIC_PASSWORD=
# R2 API token scoped to that one bucket (Object Read & Write)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto

# Snapshot series name; retention prunes only within one series (default pospay-<PGDATABASE>)
BACKUP_HOST=
# Healthchecks.io ping URL; empty disables the check-ins
HEALTHCHECK_URL=
# Retention (defaults 14 / 8 / 6)
KEEP_DAILY=
KEEP_WEEKLY=
KEEP_MONTHLY=
