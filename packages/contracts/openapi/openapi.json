{
  "openapi": "3.0.3",
  "info": {
    "title": "PosPay API",
    "version": "0.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "message_ar": {
            "type": "string",
            "minLength": 1
          },
          "message_en": {
            "type": "string",
            "minLength": 1
          },
          "details": {}
        },
        "required": ["code", "message_ar", "message_en"]
      },
      "PageQuery": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "Plan": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "name_ar": {
            "nullable": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "name_en": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "feature_flags": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          }
        },
        "required": ["id", "code", "name_ar", "name_en", "feature_flags"]
      },
      "Company": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name_ar": {
            "nullable": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "name_en": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "owner_user_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "plan_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "deleted_at": {
            "nullable": true,
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "id",
          "name_ar",
          "name_en",
          "owner_user_id",
          "plan_id",
          "created_at",
          "deleted_at"
        ]
      },
      "CreateCompanyInput": {
        "type": "object",
        "properties": {
          "name_en": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "name_ar": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "plan_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": ["name_en", "plan_id"],
        "additionalProperties": false
      },
      "Business": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "company_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "vertical_type": {
            "$ref": "#/components/schemas/VerticalType"
          },
          "name_ar": {
            "nullable": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "name_en": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "timezone": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_+-]*(?:\\/[A-Za-z0-9_+-]+)*$"
          },
          "settings": {
            "type": "object",
            "additionalProperties": {}
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "id",
          "company_id",
          "vertical_type",
          "name_ar",
          "name_en",
          "currency",
          "timezone",
          "settings",
          "created_at"
        ]
      },
      "CreateBusinessInput": {
        "type": "object",
        "properties": {
          "vertical_type": {
            "$ref": "#/components/schemas/VerticalType"
          },
          "name_en": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "name_ar": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "currency": {
            "default": "KWD",
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "timezone": {
            "default": "Asia/Kuwait",
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_+-]*(?:\\/[A-Za-z0-9_+-]+)*$"
          },
          "settings": {
            "default": {},
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": ["vertical_type", "name_en"],
        "additionalProperties": false
      },
      "Branch": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "company_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "business_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name_ar": {
            "nullable": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "name_en": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "address_ar": {
            "nullable": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "address_en": {
            "nullable": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "geo": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/GeoPoint"
              }
            ]
          },
          "opening_hours": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/OpeningHours"
              }
            ]
          },
          "is_active": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "id",
          "company_id",
          "business_id",
          "name_ar",
          "name_en",
          "address_ar",
          "address_en",
          "geo",
          "opening_hours",
          "is_active",
          "created_at"
        ]
      },
      "CreateBranchInput": {
        "type": "object",
        "properties": {
          "business_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name_en": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "name_ar": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "address_ar": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "address_en": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "geo": {
            "allOf": [
              {
                "$ref": "#/components/schemas/GeoPoint"
              }
            ]
          },
          "opening_hours": {
            "allOf": [
              {
                "$ref": "#/components/schemas/OpeningHours"
              }
            ]
          }
        },
        "required": ["business_id", "name_en"],
        "additionalProperties": false
      },
      "VerticalType": {
        "type": "string",
        "enum": ["restaurant", "salon", "laundry", "retail", "services"]
      },
      "GeoPoint": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lng": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        },
        "required": ["lat", "lng"]
      },
      "OpeningHours": {
        "maxItems": 7,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "weekday": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            },
            "intervals": {
              "minItems": 1,
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "opens": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  "closes": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  }
                },
                "required": ["opens", "closes"]
              }
            }
          },
          "required": ["weekday", "intervals"]
        }
      }
    }
  }
}
