      "GeoPoint": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lng": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        },
        "required": [
          "lat",
          "lng"
        ]
      },
      "OpeningHours": {
        "maxItems": 7,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "weekday": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            },
            "intervals": {
              "minItems": 1,
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "opens": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  "closes": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  }
                },
                "required": [
                  "opens",
                  "closes"
                ]
              }
            }
          },
          "required": [
            "weekday",
            "intervals"
          ]
        },
        "description": "Each ISO weekday (1 = Monday … 7 = Sunday) appears at most once; a missing weekday is closed. closes < opens means the interval crosses midnight. Intervals must not overlap, including across midnight and from Sunday into Monday. Enforced by the API."
      }
    }
  }
}
