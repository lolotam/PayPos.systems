@@ -215,6 +218,9 @@ function Postgres(a, b) {
       ? c.execute(queue.shift())
       : move(c, reserved)
     c.reserved.release = true
+    c.onclose = () => {
+      leaseClosed = true
+    }
 
     const sql = Sql(handler)
     sql.release = () => {
@@ -225,6 +231,8 @@ function Postgres(a, b) {
     return sql
 
     function handler(q) {
+      if (leaseClosed)
+        return q.reject(Errors.connection('CONNECTION_CLOSED', sessionOptions))
       c.queue === full
         ? queue.push(q)
         : c.execute(q) || move(c, full)
@@ -237,12 +245,19 @@ function Postgres(a, b) {
     let savepoints = 0
       , connection
       , prepare = null
+      , leaseClosed = false
 
     try {
       await sql.unsafe('begin ' + options.replace(/[^a-z ]/ig, ''), [], { onexecute }).execute()
       return await Promise.race([
         scope(connection, fn),
-        new Promise((_, reject) => connection.onclose = reject)
+        new Promise((_, reject) => {
+          // index onclose runs this before connect() can hand the Connection out.
+          connection.onclose = (error) => {
+            leaseClosed = true
+            reject(error)
+          }
+        })
       ])
     } catch (error) {
       throw error
@@ -290,6 +305,9 @@ function Postgres(a, b) {
 
       function handler(q) {
         q.catch(e => uncaughtError || (uncaughtError = e))
+        // Reconnect leaves socket non-null. Reject the closed lease before c.execute.
+        if (leaseClosed)
+          return q.reject(Errors.connection('CONNECTION_CLOSED', sessionOptions))
         c.queue === full
           ? queries.push(q)
           : c.execute(q) || move(c, full)
