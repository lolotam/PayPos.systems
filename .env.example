# Copy to .env and fill in locally. Never commit .env (CLAUDE.md §8).
# Keys only — no real values in this file.

NODE_ENV=development

# Local infrastructure — deploy/docker-compose.dev.yml (T2)
POSTGRES_DB=pospay
POSTGRES_OWNER_USER=pospay_owner
POSTGRES_OWNER_PASSWORD=
POSTGRES_PORT=5432
REDIS_PASSWORD=
REDIS_PORT=6379

# Database roles (ADR-0003 §3) — created by `pnpm db:migrate`, at least 16 characters each
POSTGRES_APP_PASSWORD=
POSTGRES_AUTH_PASSWORD=
# pospay_dispatcher — the worker's outbox dispatcher only (ADR-0003 §3, plan v4 T7b)
POSTGRES_DISPATCHER_PASSWORD=

# Connection strings
# pospay_owner — used only by `pnpm db:migrate`, never by a running app
MIGRATION_DATABASE_URL=
# pospay_app — api and worker
DATABASE_URL=
# pospay_dispatcher — worker only
DISPATCHER_DATABASE_URL=
# pospay_auth — Better Auth only (packages/auth)
AUTH_DATABASE_URL=
REDIS_URL=

# apps/api (T6b)
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info

# apps/worker (T7b)
WORKER_HOST=127.0.0.1
WORKER_PORT=3001

# Better Auth (T9a-1) — the secret signs cookies and encrypts TOTP secrets; 32+ characters, never committed
BETTER_AUTH_SECRET=
# The API's public URL; https makes session cookies Secure
BETTER_AUTH_URL=http://127.0.0.1:3000
# Comma-separated origins allowed to call the API with a cookie (admin, POS) — Better Auth's trusted
# origins and the CORS allow-list are this one list
AUTH_TRUSTED_ORIGINS=
# Parent domain for the session cookie (.pospay.systems in production, .staging.pospay.systems on
# staging); leave empty locally for a host-only cookie
COOKIE_DOMAIN=
