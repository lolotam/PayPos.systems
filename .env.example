# Copy to .env and fill in locally. Never commit .env (CLAUDE.md §8).
# Keys only — no real values in this file.
# Server-side templates: deploy/staging.env.example (staging compose) and deploy/backup/backup.env.example.

NODE_ENV=development

# Local infrastructure — deploy/docker-compose.dev.yml (T2)
POSTGRES_DB=pospay
POSTGRES_OWNER_USER=pospay_owner
POSTGRES_OWNER_PASSWORD=
POSTGRES_PORT=5432
REDIS_PASSWORD=
REDIS_PORT=6379

# Database roles (ADR-0003 §3) — created by `pnpm db:migrate`, at least 16 characters each
POSTGRES_APP_PASSWORD=
POSTGRES_AUTH_PASSWORD=
# pospay_dispatcher — the worker's outbox dispatcher only (ADR-0003 §3, plan v4 T7b)
POSTGRES_DISPATCHER_PASSWORD=

# Connection strings
# pospay_owner — used only by `pnpm db:migrate`, never by a running app
MIGRATION_DATABASE_URL=
# pospay_app — api and worker
DATABASE_URL=
# pospay_dispatcher — worker only
DISPATCHER_DATABASE_URL=
# pospay_auth — Better Auth only (packages/auth)
AUTH_DATABASE_URL=
REDIS_URL=

# apps/api (T6b)
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info

# apps/worker (T7b)
WORKER_HOST=127.0.0.1
WORKER_PORT=3001

# Notifications (ADR-0018) — fake is development/test only; outbound admission and OTP remain gated on PR 6.
NOTIFICATIONS_MODE=fake
# Frozen platform phone HMAC key and stable key identifier, API + worker; provision through Dokploy secrets.
NOTIFICATION_PHONE_HASH_KEY=
NOTIFICATION_PHONE_HASH_KEY_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0
# TODO(spec): approved logical-template/locale Meta names, copy and admission quantities after owner approval.

# Better Auth (T9a-1) — the secret signs cookies and encrypts TOTP secrets; 32+ characters, never committed
BETTER_AUTH_SECRET=
# The API's public URL; https makes session cookies Secure
BETTER_AUTH_URL=http://127.0.0.1:3000
# Comma-separated origins allowed to call the API with a cookie (admin, POS) — Better Auth's trusted
# origins and the CORS allow-list are this one list
AUTH_TRUSTED_ORIGINS=
# Parent domain for the session cookie (.pospay.systems in production, .staging.pospay.systems on
# staging); leave empty locally for a host-only cookie
COOKIE_DOMAIN=

# Public origin of the API, inlined into the admin app at build time. Not a secret.
# Must also be listed in AUTH_TRUSTED_ORIGINS. Example: http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=
# Public origin of the API, inlined into the POS app at build time. Not a secret.
# Example: http://127.0.0.1:3000
VITE_API_URL=

# ADR-0013 global messaging intake: pospay_notifications, never pospay_owner.
POSTGRES_NOTIFICATIONS_PASSWORD=
PLATFORM_NOTIFICATIONS_DATABASE_URL=
# Independent domain-separated message HMAC in the same frozen platform key family/id.
NOTIFICATION_MESSAGE_ID_HASH_KEY=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WABA_ID=
# TODO(spec): exact owner-approved STOP button id; empty means no button is accepted.
WHATSAPP_STOP_BUTTON_ID=
# Exact trusted Traefik CIDRs only; empty trusts no forwarded IP.
TRUSTED_PROXY_CIDRS=
