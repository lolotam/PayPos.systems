{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build", "build"]
    },
    "@pospay/auth#test": {
      "dependsOn": ["^build", "build", "@pospay/db#test"]
    },
    "@pospay/api#test": {
      "dependsOn": ["^build", "build", "@pospay/auth#test"]
    },
    "@pospay/worker#test": {
      "dependsOn": ["^build", "build", "@pospay/api#test"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "@pospay/pos#build:native": {
      "dependsOn": ["^build"],
      "outputs": ["dist-native/**"],
      "env": ["FLAVOUR", "VITE_API_URL"]
    },
    "@pospay/business#sync:staging": {
      "dependsOn": ["@pospay/pos#build:native"],
      "cache": false,
      "env": ["FLAVOUR", "VITE_API_URL"]
    },
    "@pospay/business#sync:production": {
      "dependsOn": ["@pospay/pos#build:native"],
      "cache": false,
      "env": ["FLAVOUR", "VITE_API_URL"]
    }
  }
}
